{
  "expo": {
    "name": "StyleUp",
    "slug": "styleup",
    "version": "1.0.0",
    "orientation": "portrait",
    "jsEngine": "jsc",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F6F2EA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.styleup.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F2EA"
      },
      "package": "com.styleup.app"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
